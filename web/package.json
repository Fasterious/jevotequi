{
  "name": "jevotequi",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "Je vote qui ? Les votes réels des députés à l'Assemblée nationale depuis 2022, pour décider en connaissance de cause.",
  "scripts": {
    "data": "python3 -I ../pipeline/run.py all",
    "build": "vite build && node scripts/postbuild.mjs",
